{% extends "__layout.twig" %}

{% import "macros.twig" as macros %}

{% block content %}
    <div class="mb-3">
        <h5>Здесь вы узнаете о технике {{ object_name }} и не только...</h5>
    </div>

    <ul class="nav mb-3">
        <li class="nav-item">
            {{ macros.btn("Картинка", object_image_url, current_url == object_image_url, "primary") }}
        </li>
        <li class="nav-item">
            {{ macros.btn("Описание", object_info_url, current_url == object_info_url, "primary") }}
        </li>
    </ul>

    {% block objectContent %}
        <div class="border p-3 rounded">
            Выберите, какую информацию хотите посмотреть
        </div>
    {% endblock %}
{% endblock %}