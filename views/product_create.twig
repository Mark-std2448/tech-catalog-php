{% extends "__layout.twig" %}

{% block content %}
<div class="container mt-4" style="max-width: 800px;">
    <h1 class="display-6 fw-normal">Добавление товара</h1>
    <hr>

    {% if message %}
        <div class="alert alert-success d-flex flex-column gap-2" role="alert">
            <div>{{ message }}</div>
            <div>
                <a href="/product/{{ new_id }}" class="fw-bold text-success text-decoration-underline">
                    Посмотреть созданный товар &raquo;
                </a>
            </div>
        </div>
    {% endif %}

    <form method="POST" enctype="multipart/form-data" class="row g-3 bg-white p-4 border rounded shadow-sm">
        
        <div class="col-md-6">
            <label class="form-label">Название девайса</label>
            <input type="text" class="form-control" name="title" required>
        </div>
        
        <div class="col-md-6">
            <label class="form-label">Категория (Тип)</label>
            <select class="form-select" name="type">
                {% for type in types %}
                    <option value="{{ type.name }}">{{ type.name|title }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="col-12">
            <label class="form-label">Краткое описание (для плитки)</label>
            <input type="text" class="form-control" name="description" required>
        </div>
        
        <div class="col-12">
            <label class="form-label">Изображение товара</label>
            <input type="file" class="form-control" name="image" accept="image/*" required>
        </div>
        
        <div class="col-12">
            <label class="form-label">Полные технические характеристики</label>
            <textarea name="info" class="form-control" rows="5" placeholder="Процессор, память, видеокарта..." required></textarea>
        </div>
        
        <div class="col-12 text-end">
            <button type="submit" class="btn btn-primary px-4">Добавить девайс</button>
        </div>
    </form>
</div>
{% endblock %}